{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "background": "#FFFFFF",
    "primaryColor": "#EEF3FB",
    "primaryBorderColor": "#2F5597",
    "primaryTextColor": "#1B1F23",
    "secondaryColor": "#FFF6E5",
    "secondaryBorderColor": "#C08A1E",
    "tertiaryColor": "#F5F7FA",
    "tertiaryBorderColor": "#A0AEC0",
    "lineColor": "#4A5568",
    "textColor": "#1B1F23",
    "edgeLabelBackground": "#FFFFFF",
    "clusterBkg": "#F7F9FC",
    "clusterBorder": "#A0AEC0",
    "titleColor": "#1B1F23",
    "actorBkg": "#EEF3FB",
    "actorBorder": "#2F5597",
    "actorTextColor": "#1B1F23",
    "actorLineColor": "#A0AEC0",
    "signalColor": "#2D3748",
    "signalTextColor": "#1B1F23",
    "labelBoxBkgColor": "#EEF3FB",
    "labelBoxBorderColor": "#2F5597",
    "labelTextColor": "#1B1F23",
    "loopTextColor": "#1B1F23",
    "noteBkgColor": "#FFF6E5",
    "noteBorderColor": "#C08A1E",
    "noteTextColor": "#1B1F23",
    "activationBkgColor": "#DDE7F6",
    "activationBorderColor": "#2F5597",
    "sequenceNumberColor": "#FFFFFF"
  },
  "flowchart": {
    "useMaxWidth": false,
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 50,
    "rankSpacing": 70,
    "padding": 18,
    "diagramPadding": 20,
    "wrappingWidth": 220,
    "subGraphTitleMargin": {
      "top": 6,
      "bottom": 10
    }
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "wrap": true,
    "width": 150,
    "height": 60,
    "actorMargin": 45,
    "messageMargin": 48,
    "boxMargin": 12,
    "boxTextMargin": 8,
    "noteMargin": 14,
    "actorFontSize": 16,
    "actorFontWeight": 600,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "diagramMarginX": 24,
    "diagramMarginY": 20,
    "rightAngles": false
  },
  "gantt": {
    "useMaxWidth": false,
    "fontSize": 14,
    "sectionFontSize": 15,
    "barHeight": 26,
    "barGap": 8,
    "topPadding": 50,
    "leftPadding": 170,
    "gridLineStartPadding": 40
  },
  "themeCSS": ".messageText, .noteText, .loopText, .labelText { paint-order: stroke fill; stroke: #FFFFFF; stroke-width: 7px; stroke-linejoin: round; } .cluster-label span, .cluster-label div, .cluster-label p { background-color: #F7F9FC; }"
}
